generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  exercises   Exercise[]       @relation("UserExercises")
  sessions    WorkoutSession[]
  foods       Food[]           @relation("UserFoods")
  foodEntries FoodEntry[]
  bodyWeights BodyWeight[]
}

enum MuscleGroup {
  BICEPS
  TRICEPS
  CHEST
  BACK
  SHOULDERS
  LEGS
  CORE
}

model Exercise {
  id          String      @id @default(cuid())
  name        String
  muscleGroup MuscleGroup
  isCustom    Boolean     @default(false)
  userId      String?
  user        User?       @relation("UserExercises", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  workoutSets WorkoutSet[]

  @@unique([name, userId])
  @@index([muscleGroup])
  @@index([userId])
}

model WorkoutSession {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime     @default(now()) @db.Date
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sets WorkoutSet[]
  run  RunEntry?

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model WorkoutSet {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setNumber  Int
  reps       Int
  weight     Float
  createdAt  DateTime       @default(now())

  @@index([sessionId])
  @@index([exerciseId])
  @@index([sessionId, exerciseId])
}

model RunEntry {
  id              String         @id @default(cuid())
  sessionId       String         @unique
  session         WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  distanceMeters  Int
  durationSeconds Int
  caloriesBurned  Int?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Food {
  id              String      @id @default(cuid())
  nameEn          String
  nameRu          String?
  caloriesPer100g Float
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?
  isCustom        Boolean     @default(false)
  userId          String?
  user            User?       @relation("UserFoods", fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())

  entries FoodEntry[]

  @@unique([nameEn, userId])
  @@index([userId])
}

enum Meal {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model FoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  grams     Float
  date      DateTime @db.Date
  meal      Meal?
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([foodId])
}

model BodyWeight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg  Float
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}
